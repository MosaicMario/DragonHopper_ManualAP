{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "user": {
        "stagesanity":{
            "description": [
                "Every substage will have its own unlock item. Additionally, you will need to find Unlock",
                "Stage 6-6 and Unlock Stage 6-8 to be able to fight Lexer and King Hades respectively."
            ],
            "type": "Toggle",
            "default": false,
            "group": "Stage Options"
        },
        "starting_stage": {
            "display_name": "Starting Stage",
            "description": [
                "Choose a stage as a starting area.",
                "A random substage of the chosen stage will be picked as the starting area when Stagesanity is enabled.",
                "Boss stages and stages that can't progress without a progression item are excluded from the substage pool."
            ],
            "type": "Choice",
            "values": {
                "Stage0": 0,
                "Stage1": 1,
                "Stage2": 2,
                "Stage3": 3,
                "Stage4": 4,
                "Stage5": 5,
                "Stage6": 6
            },
            "group": "Stage Options"
        },
        "lexer_fight_unlock":{
            "display_name": "Lexer Fight Unlock",
            "type": "Choice",
            "description": [
                "Criteria under which Stage 6-6 becomes accessible to fight Lexer.",
                "Star Medals: Collect the required number of Star Medals",
                "Bosses: Defeat the required number of bosses",
                "Spirits: Release the required number of spirits"
            ],
            "values": {
                "Star_Medals":0,
                "Bosses":1,
                "Spirits":2
             },
            "default": 0,
            "allow_custom_value": false,
            "group": "Game Options"
        },
        "star_medals_required":{
            "display_name": "Star Medals Required",
            "type": "Range",
            "description": [
                "Number of required Star Medals to collect when Lexer Fight Unlock is set to Star Medals."
            ],
            "range_start": 1,
            "default": 80,
            "range_end": 110,
            "group": "Game Options"
        },
        "bosses_required":{
            "display_name": "Bosses Required",
            "type": "Range",
            "description": [
                "Number of required bosses to defeat when Lexer Fight Unlock is set to Bosses."
            ],
            "range_start": 1,
            "default": 4,
            "range_end": 5,
            "group": "Game Options"
        },
        "spirits_required":{
            "display_name": "Spirits Required",
            "type": "Range",
            "description": [
                "Number of required spirits to be released when Lexer Fight Unlock is set to Spirits."
            ],
            "range_start": 1,
            "default": 3,
            "range_end": 4,
            "group": "Game Options"
        }
    }

}
